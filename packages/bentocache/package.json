{
  "name": "bentocache",
  "version": "1.6.1",
  "description": "Multi-tier cache module for Node.js. Redis, Upstash, CloudfareKV, File, in-memory and others drivers",
  "keywords": [
    "cache",
    "caching",
    "in-memory",
    "multi-tier",
    "redis",
    "tiered"
  ],
  "license": "MIT",
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "files": [
    "build"
  ],
  "type": "module",
  "main": "build/index.js",
  "typesVersions": {
    "*": {
      ".": [
        "./build/index.d.ts"
      ],
      "drivers/*": [
        "./build/src/drivers/*.d.ts"
      ],
      "plugins/*": [
        "./build/plugins/*.d.ts"
      ],
      "test_suite": [
        "./build/src/test_suite.d.ts"
      ],
      "types": [
        "./build/src/types/main.d.ts"
      ]
    }
  },
  "exports": {
    ".": "./build/index.js",
    "./drivers/redis": "./build/src/drivers/redis.js",
    "./drivers/memory": "./build/src/drivers/memory.js",
    "./drivers/file": "./build/src/drivers/file/file.js",
    "./drivers/dynamodb": "./build/src/drivers/dynamodb.js",
    "./drivers/base_driver": "./build/src/drivers/base_driver.js",
    "./drivers/database": "./build/src/drivers/database/database.js",
    "./drivers/knex": "./build/src/drivers/database/adapters/knex.js",
    "./drivers/kysely": "./build/src/drivers/database/adapters/kysely.js",
    "./drivers/orchid": "./build/src/drivers/database/adapters/orchid.js",
    "./types": "./build/src/types/main.js",
    "./plugins/*": "./build/plugins/*.js",
    "./test_suite": "./build/src/test_suite.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "clean": "del-cli build",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "quick:test": "cross-env NODE_NO_WARNINGS=1 node --enable-source-maps --import=tsx bin/test.ts",
    "pretest": "pnpm lint",
    "test": "c8 pnpm quick:test",
    "build": "pnpm clean && tsup-node",
    "postbuild": "pnpm copy:templates",
    "release": "pnpm build && pnpm release-it",
    "version": "pnpm build",
    "prepublishOnly": "pnpm build",
    "checks": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@boringnode/bus": "^0.10.0",
    "@julr/utils": "^1.9.0",
    "@poppinss/exception": "^1.2.3",
    "async-mutex": "^0.5.0",
    "lru-cache": "^11.5.3",
    "p-timeout": "^8.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1153.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "emittery": "^2.1.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "kysely": "^0.29.7",
    "mysql2": "^3.24.6",
    "orchid-orm": "1.55.1",
    "p-event": "^8.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-loki": "^3.0.0",
    "sqlite3": "^6.0.1",
    "superjson": "^2.2.6"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.438.0",
    "ioredis": "^5.3.2 || ^6.0.0",
    "knex": "^3.0.1",
    "kysely": "^0.27.3",
    "orchid-orm": "^1.24.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "knex": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "orchid-orm": {
      "optional": true
    }
  },
  "c8": {
    "exclude": [
      "bin",
      "tests/**",
      "test_helpers/**",
      "factories/**"
    ],
    "reporter": [
      "text",
      "html"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): bentocache@${version}",
      "tagAnnotation": "release ${version}",
      "tagName": "bentocache@${version}"
    },
    "github": {
      "release": true,
      "releaseName": "bentocache@${version}",
      "web": true
    }
  }
}
