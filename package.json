{
  "name": "@bentocache/monorepo",
  "private": true,
  "description": "Multi-tier cache module for Node.js. Redis, Upstash, CloudfareKV, File, in-memory and others drivers",
  "license": "MIT",
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm run -r --parallel typecheck",
    "build": "pnpm run -r build",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "checks": "pnpm lint && pnpm format:check && pnpm typecheck",
    "test": "pnpm run -r --parallel test"
  },
  "devDependencies": {
    "@adonisjs/tsconfig": "^2.0.0",
    "@changesets/cli": "^3.0.3",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.4.0",
    "@julr/tooling-configs": "^6.1.2",
    "@swc/core": "^1.16.18",
    "@types/node": "^25.9.9",
    "c8": "^12.0.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "del-cli": "^8.0.1",
    "dotenv": "^18.0.8",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.2.0",
    "release-it": "^21.1.1",
    "testcontainers": "^12.2.1",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18.16.0"
  },
  "packageManager": "pnpm@12.14.0"
}
